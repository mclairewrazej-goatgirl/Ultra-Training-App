{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/mwrazej_training_log.html"
    },
    {
      "source": "/.netlify/functions/:name",
      "destination": "/api/:name"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://mwrazej-training.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://mwrazej-training.firebaseapp.com/__/firebase/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/parse-plan.js": {
      "maxDuration": 300
    }
  }
}
